# SkillSwap AI - Backend Environment Configuration Example
# Copy this file to .env and fill in real values locally

PROJECT_NAME="SkillSwap AI API"
API_V1_STR="/api"
ENVIRONMENT="development"

# CORS origins allowed to communicate with FastAPI (comma-separated list)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173"

# PostgreSQL Database Connection String
# Format: postgresql+psycopg://username:password@hostname:port/database_name
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/skillswap_db"

# JWT Authentication Secret Key
JWT_SECRET="change-this-to-a-secure-random-secret-key-in-production"
